				"android.permission.CHANGE_WIFI_STATE",
				"android.permission.ACCESS_FINE_LOCATION",
				"android.permission.ACCESS_NETWORK_STATE",
				"android.permission.CHANGE_WIFI_MULTICAST_STATE",
				"android.permission.MODIFY_AUDIO_SETTINGS",
				"android.permission.RECORD_AUDIO",
				"android.permission.CAMERA",
				"android.permission.BLUETOOTH",
				"android.permission.RECEIVE_BOOT_COMPLETED",
				"android.permission.MOUNT_UNMOUNT_FILESYSTEMS",
				"android.permission.READ_LOGS",
				"android.permission.READ_EXTERNAL_STORAGE",
				"android.permission.WRITE_EXTERNAL_STORAGE",
				"android.permission.ACCESS_MEDIA_LOCATION",
				"android.permission.VIBRATE",
				"android.permission.FLASHLIGHT",
				"ezviz.ezopensdk.push.sdk.permission.EZVIZ_MESSAGE",
				"ezviz.ezopensdk.permission.C2D_MESSAGE",
				"com.google.android.c2dm.permission.RECEIVE",
				"android.permission.GET_ACCOUNTS",
				"android.permission.WAKE_LOCK",
				"android.permission.FOREGROUND_SERVICE"
			],
			"parameters": {}
		},
		"ios": {
			"plugins": [{
				"type": "module",
				"name": "super_ezviz",
				"class": "UniOpenSDKModule"
			},
			{
				"type": "component",
				"name": "UniOpenSDK",
				"class": "UniOpenSDKComponent"
			},{
				"type": "module",
				"name": "super_ezviz_videotalk",
				"class": "UniVideoTalkModule"
			},
			{
				"type": "component",
				"name": "ErtcVideoView",
				"class": "ErtcVideoViewComponent"
			}
			],
			"frameworks": [
				"libsqlite3.0.tbd",
				"CoreMedia.framework",
				"AudioToolbox.framework",
				"VideoToolbox.framework",
				"GLKit.framework",
				"OpenAL.framework",
				"MobileCoreServices.framework",
				"AVFoundation.framework",
				"CoreTelephony.framework",
				"SystemConfiguration.framework",
				"libc++.tbd",
				"libiconv.tbd",
				"libbz2.tbd",
				"libz.tbd"
			],
			"capabilities": {   
				"entitlements": {   
					"com.apple.developer.networking.HotspotConfiguration":true
				}            
			},
			"resources": [
				"CNN_SR_X2_fp16_ios_w828xh1472.bin",
				"CNN_SR_X2_fp16_ios_w1472xh828.bin",
				"CNN_SR_X4_fp16_ios_w432xh768.bin",
				"CNN_SR_X4_fp16_ios_w768xh432.bin",
				"com.hri.hpc.mobile.ios.player.metallib"
			],
